{
  "name": "our-block",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "node --import tsx server/index.ts --production",
    "test": "node --import tsx --test tests/*.test.ts tests/*.test.tsx",
    "export:unity": "node --import tsx scripts/export-content.ts",
    "format": "prettier --write \"{shared,server,src,tests,scripts}/**/*.{ts,tsx,css}\"",
    "migrate:cloud": "node --import tsx scripts/migrate-storage.ts",
    "backup": "node --import tsx scripts/backup-storage.ts",
    "restore": "node --import tsx scripts/restore-storage.ts",
    "test:load": "node --import tsx scripts/load-test.ts",
    "verify:backup": "node --import tsx scripts/verify-backup.ts",
    "measure:assets": "node --import tsx scripts/measure-assets.ts"
  },
  "dependencies": {
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.180.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.180.0",
    "@types/ws": "^8.18.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
